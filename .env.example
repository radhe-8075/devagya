OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-6.1-sol
OPENAI_LLM_MODEL=gpt-6.1-sol
PORT=3000

# Optional: lets staff change request status via POST /api/admin/status (x-admin-key header)
ADMIN_KEY=

# LLM answers for questions the rules cannot understand (Gemini is tried first, then OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-2.5-flash

# Optional: dedicated Devagya 2.0 n8n webhook (server-side only)
N8N_SMART_CAMPUS_WEBHOOK_URL=
# Required to call POST /api/smart-campus/automation/dispatch from a trusted server
AUTOMATION_API_KEY=
